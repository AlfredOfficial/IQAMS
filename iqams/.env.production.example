# IQAMS production environment contract.
# Copy these settings through the deployment secret manager or runtime
# environment injection. Do not commit a populated production .env file.

APP_NAME=IQAMS
APP_ENV=production
APP_KEY=<inject-from-secret-manager>
APP_DEBUG=false
APP_URL=https://<production-hostname>
APP_TIMEZONE=Asia/Manila

AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<production-db-host>
DB_PORT=3306
DB_DATABASE=<production-db-name>
DB_USERNAME=<production-db-user>
DB_PASSWORD=<inject-from-secret-manager>
DB_CONNECT_TIMEOUT=5
# Use the CA bundle supplied by the database provider when TLS is required.
MYSQL_ATTR_SSL_CA=<provider-ca-path>

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=<production-redis-host>
REDIS_PORT=6379
REDIS_USERNAME=<optional>
REDIS_PASSWORD=<inject-from-secret-manager>
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<inject-from-secret-manager>
MAIL_PASSWORD=<inject-from-secret-manager>
MAIL_EHLO_DOMAIN=<production-hostname>
MAIL_FROM_ADDRESS=<verified-sender-address>
MAIL_FROM_NAME=IQAMS

# Keep the default disk private. Profile photos explicitly use the public
# disk in the current application; leave requests use the private disk.
FILESYSTEM_DISK=local

# Set an explicit cutoff before accepting legacy QR identifiers in production.
ATTENDANCE_LEGACY_QR_CUTOFF=<iso-8601-cutoff>
ATTENDANCE_MAX_REPORT_DAYS=366
ATTENDANCE_REPORT_EXPORT_TTL_HOURS=24
IQAMS_HEARTBEAT_TTL_SECONDS=300
IQAMS_HEALTH_MAX_AGE_SECONDS=120
