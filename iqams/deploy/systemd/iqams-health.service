[Unit]
Description=Check IQAMS queue and scheduler health
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/iqams
EnvironmentFile=/etc/iqams/iqams.env
ExecStart=/usr/bin/php artisan ops:health
StandardOutput=journal
StandardError=journal
